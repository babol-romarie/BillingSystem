<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Avoid copying the apphost executable during builds which can fail when the app
         is running. This prevents MSB3027 "file is locked by" errors while iterating.
         If you need an exe as the output for deployment/testing, remove or override
         this property. -->
    <UseAppHost>false</UseAppHost>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>f497b885-cc6c-434f-9c26-825536b31364</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="6.0.1" />
    <PackageReference Include="MySql.Data" Version="26.7.0" />
  </ItemGroup>

</Project>